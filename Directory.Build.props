<Project>

    <!-- Package metadata shared by every project. -->
    <PropertyGroup>
        <Version>1.1.0</Version>
        <Authors>Xavier Klausener</Authors>
        <Company>Xavier Klausener</Company>
        <Product>Tickwork</Product>
        <Copyright>Copyright (c) 2025-present Arcenox LLC; Copyright (c) 2026 Xavier Klausener</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <RepositoryUrl>https://github.com/xaviergxf/Tickwork</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/xaviergxf/Tickwork</PackageProjectUrl>
        <PackageTags>tickwork;scheduler;cron;background-jobs;jobs;queue;time;fire-and-forget</PackageTags>
        <PackageReleaseNotes>1.1.0 - reliability fixes, same database schema. A ticker the fallback took over while it was queued is no longer run a second time (Queued to InProgress is a compare-and-set on the node's lock). Stopping the host no longer freezes the task scheduler between acquiring tickers and queueing them. A cancellation request no longer disposes the source of the execution still running, and an ending execution no longer removes a newer registration of the same ticker. Requests persisted before compression was switched on or off are read either way. The EF Core queries that load children and grandchildren run as one query (AsSingleQuery), which removes warning 20504. README: the generic host's UseTickwork, and the SQLite schema warning. Adapted from TickerQ fixes up to b2aefd0.</PackageReleaseNotes>
    </PropertyGroup>

    <!-- LICENSE and NOTICE travel in every package. -->
    <ItemGroup Condition="'$(IsPackable)' != 'false'">
        <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Visible="false" />
        <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="" Visible="false" />
    </ItemGroup>

</Project>
