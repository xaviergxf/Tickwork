<Project>

    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>

        <!-- Source Link -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!--
      One version per target framework for the Microsoft packages. On net11.0 the
      Microsoft.Extensions abstractions are part of the shared framework (a package
      reference is NU1510), so they are referenced for net10.0 only.
    -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <EfCoreVersion>10.0.13</EfCoreVersion>
        <MicrosoftExtensionsVersion>10.0.13</MicrosoftExtensionsVersion>
        <AspNetCoreVersion>10.0.13</AspNetCoreVersion>
        <NpgsqlEfCoreVersion>10.0.3</NpgsqlEfCoreVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <EfCoreVersion>11.0.0-rc.2.26504.105</EfCoreVersion>
        <MicrosoftExtensionsVersion>11.0.0-rc.2.26504.105</MicrosoftExtensionsVersion>
        <AspNetCoreVersion>11.0.0-rc.2.26504.105</AspNetCoreVersion>
        <NpgsqlEfCoreVersion>11.0.0-rc.2</NpgsqlEfCoreVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.402" PrivateAssets="All" />
    </ItemGroup>

</Project>
